# Copia este archivo a .env y completa con tus valores reales
DATABASE_URL="postgresql://usuario:password@localhost:5432/pizarra?schema=public"
PORT=4000
FRONTEND_URL="http://localhost:3000"

# Duración por defecto de una votación de borrado, en minutos
VOTACION_DURACION_MIN=10

# Quórum mínimo de votos y umbral de aprobación (0.0 a 1.0)
VOTACION_QUORUM_MIN=15
VOTACION_UMBRAL_APROBACION=0.6

# Máximo de votaciones que una misma sesión anónima puede iniciar por hora
LIMITE_VOTACIONES_POR_HORA=3
